<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_surface" android:padding="12dp">
    <ImageView android:id="@+id/widget_icon" android:layout_width="32dp" android:layout_height="32dp"
        android:background="@drawable/widget_chip" android:padding="6dp" android:src="@drawable/widget_calendar_check"
        android:contentDescription="Calendar" />
    <TextView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_icon" android:layout_centerVertical="true" android:layout_marginStart="10dp"
        android:text="JW Task Scheduler" android:textColor="@color/widget_on_surface" android:textSize="14sp"
        android:textStyle="bold" android:fontFamily="sans-serif" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true"
        android:layout_centerVertical="true" android:text="›" android:textColor="@color/widget_primary" android:textSize="30sp" />
    <TextView android:id="@+id/widget_congregation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/widget_icon" android:layout_marginTop="6dp" android:text="Quarry Congregation"
        android:textColor="@color/widget_secondary" android:textSize="11sp" android:singleLine="true"
        android:ellipsize="end" android:fontFamily="sans-serif" />
    <TextView android:id="@+id/widget_next_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/widget_congregation"
        android:layout_marginTop="6dp" android:background="@drawable/widget_chip" android:paddingStart="10dp"
        android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="NEXT MEETING"
        android:textColor="@color/widget_primary" android:textSize="9sp" android:textStyle="bold" android:fontFamily="sans-serif" />
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/widget_next_label" android:layout_marginTop="6dp" android:text="Sun, Nov 15"
        android:textColor="@color/widget_on_surface" android:textSize="14sp" android:textStyle="bold"
        android:singleLine="true" android:ellipsize="end" android:fontFamily="sans-serif" />
    <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_below="@id/widget_date" android:layout_marginTop="2dp" android:text="7:45 AM"
        android:textColor="@color/widget_primary" android:textSize="24sp" android:textStyle="bold" android:fontFamily="sans-serif" />
    <TextView android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_below="@id/widget_time" android:layout_marginTop="-1dp" android:text="In 3 days"
        android:textColor="@color/widget_secondary" android:textSize="10sp" android:fontFamily="sans-serif" />
</RelativeLayout>
